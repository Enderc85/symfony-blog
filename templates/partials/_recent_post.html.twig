<div class="post" style="margin-bottom: 15px;">
    <div class="post-heading" style="overflow: hidden; max-height: 140px;">
        <span>{{ recent.publishedAt | date('d') }} {{ recent.publishedAt | date('F') }}</span>
        <a href="{{ path('single_post', {'slug': recent.slug}) }}">
            <img class="img-responsive" src="{{ asset('images/blog/' ~ recent.image) }}" alt="{{ recent.title }}"
                style="width: 100%; height: 140px; object-fit: cover;">
        </a>
    </div>
    <div class="post-body" style="padding: 8px 0 4px;">
        <h5 style="margin: 0 0 4px;">
            <a href="{{ path('single_post', {'slug': recent.slug}) }}">
                <strong>{{ recent.title }}</strong>
            </a>
        </h5>
        <small class="text-muted">
            <i class="fa fa-user sr-icons"></i>
            {{ recent.postUser is not null ? recent.postUser.name : 'Unknown' }}
        </small>
    </div>
    <div class="post-footer" style="padding: 4px 0; font-size: 13px;">
        <span>
            <i class="fa fa-heart sr-icons"></i> {{ recent.numLikes }}
            <i class="fa fa-comments sr-icons"></i> {{ recent.numComments }}
        </span>
    </div>
</div>