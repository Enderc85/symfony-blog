{% extends 'base.html.twig' %}
{% block body %}
{% if not post %}
<h1>Post not found</h1>
{% else %}

<!-- Principal Content Start -->
<div id="single">
    <div class="container">

        <!-- Full Article -->
        <div class="row">
            <h2>{{ post.title }}</h2>
            <hr class="subtitle">
            <img src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.title }}"
                class="img-responsive center-block">
            <div class=" block1">
                <div class="col-xs-12 col-sm-9">
                    <p>{{ post.content }}</p>
                    <h4>- By {{ post.postUser.name }}</h4>
                    <hr>
                    <ul class="list-inline">
                        <li>{{ post.publishedAt|date('d M Y') }} |</li>
                        <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i>
                            {{post.numComments}} |</li>

                        <li><a href="{{ path('post_like', {slug: post.slug}) }}">LIKE</a> <i
                                class="fa fa-heart sr-icons"></i> <span id="likes">{{post.numLikes}}</span></li>

                    </ul>
                </div>
                <div class="col-xs-12 col-sm-3">
                    <h4>Recent Post</h4>
                    <hr class="subtitle1">
                    <div class="recentPostContainer">
                        {% for recent in recents %}
                        {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        <!-- End of Full Article -->

        <!-- Comments -->
        <div class="row">
            <div class="col-xs-12 col-sm-12 block2">
                {% for comment in post.comments %}
                <div class="comment">
                    <h4>{{ comment.name }}</h4>
                    <span>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                    </span>
                    <p class="time">{{ comment.publishedAt|date('d M Y') }}</p>
                    <hr>
                    <p>{{ comment.text }}</p>
                </div>
                {% endfor %}
                <hr class="line">
                <div id="form" class="col-xs-12 col-sm-6 col-sm-push-3">
                    {{ include ('partials/_post_comments.html.twig') }}
                </div>
            </div>
        </div>
        <!-- End of Comments -->
    </div>
</div>
<!-- End of Principal Content Start -->
{%if post%}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const likeLink = document.querySelector('a[href="{{ path('post_like', {slug: post.slug}) }}"]');
        // Hay que coger el id 'likes' para poder cambiar luego el valor al número de likes actual
        const likesSpan = document.querySelector('#likes');
        if (likeLink) {
            likeLink.addEventListener('click', function (event) {
                event.preventDefault();
                fetch(likeLink.href, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            likesSpan.innerHTML = " " + data.likes;
                        }
                    })
                    .catch(error => console.error('Error:', error));
            });
        }
    });
</script>
{%endif%}
</body>

</html>
{% endif %}
{% endblock %}