{% extends 'base.html.twig' %}
{% block title%}Images{% endblock %}
{% block body%}
<!-- Principal Content Start -->
<div id="images">
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            <h1>Images</h1>

            {{ form_start(imageForm, {'attr': {'class':'form-horizontal'}}) }}
            <div class="formGroup">
                {{ form_row(imageForm.file, {'attr': {'class':'form-control'}}) }}
                {{ form_row(imageForm.category, {'attr': {'class':'form-horizontal'}}) }}
                {{ form_row(imageForm.Send, {'attr': {'class':'pull-right btn btn-lg sr-button'}}) }}
            </div>
            {{ form_end(imageForm) }}

            <hr>
        </div>
    </div>
</div>
<!-- Principal Content Start -->
{% endblock %}